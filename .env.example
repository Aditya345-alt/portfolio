# Email Backend Configuration
# -------------------------------------------------------------
# For live email delivery, sign up for a free account on Resend (https://resend.com)
# or provide an API key from your preferred email provider.

# Your Email Service API Key (e.g., re_123456789 from Resend)
EMAIL_API_KEY=

# The "From" email address. With Resend free tier without a custom domain, you can use:
EMAIL_FROM=Portfolio Contact <onboarding@resend.dev>

# The personal email address where you want to receive portfolio contact submissions
CONTACT_RECEIVER_EMAIL=aj3934426@gmail.com
